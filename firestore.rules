rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/backups/dashboard {
   allow read, delete: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['payload','revision','updatedAt'])
    && request.resource.data.payload is string
    && request.resource.data.payload.size() < 900000
    && request.resource.data.revision is int
    && request.resource.data.revision > 0
    && request.resource.data.updatedAt == request.time;
  }
 }
}
